 + valuated stock in transit","movement":"687 documented for AIC-relevant sales item","integration":"SD→MM-PUR→IC SD→VSiT→Billing→MM-IV→FI/CO + Value Chain Monitoring"},"data_hinges":["delivering plant","confirmed quantity","transit plant","transfer-of-control dates/Incoterms"],"failures":["no IC PO","broken generated chain","VSiT/accounting timing mismatch"],"tests":["AIC happy path","unconfirmed item not transferred to IC PO"]},{"code":"SD.MTO","control_signature":{"item":"TAN in documented strategy-20 example","schedule_line":"CP in documented strategy-20 example","requirements_type":"KE in documented strategy-20 example","planning":"strategy group/MRP group drive requirements behavior","stock":"sales order stock","integration":"SD→MRP/PP→sales-order stock→Delivery→CO/FI"},"data_hinges":["strategy group","MRP group","plant","sales-order-stock valuation design"],"failures":["no order-specific supply","receipt to wrong stock segment","wrong ATP logic"],"tests":["strategy-20 happy path","change strategy to prove supply logic can change while SD item remains TAN"]}],"source_ids":["SRC-SAP-SALES-CONTROL","SRC-SAP-ITEM-CAT-DET","SRC-SAP-SCHEDULE-LINE","SRC-SAP-SHIPPING-POINT","SRC-SAP-PRICING-PROCEDURE","SRC-SAP-TPO-CONTROL","SRC-SAP-TPO-BILLING","SRC-SAP-PTO-CONTROL","SRC-SAP-PTO-STOCK","SRC-SAP-CONSIGNMENT-FILL","SRC-SAP-CONSIGNMENT-ISSUE","SRC-SAP-MOVEMENT-TYPES","SRC-SAP-CLASSIC-IC-PREREQ","SRC-SAP-AIC-CONTROL","SRC-SAP-AIC-SALES-ORDER","SRC-SAP-MTO-COST","SRC-SAP-MTO-STRATEGY20"]}